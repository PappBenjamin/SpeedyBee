<UserControl x:Class="SpeedyBee.Views.VisualizationViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#1A1A1A"
            BorderBrush="Gray"
            BorderThickness="1"
            Margin="0,10">
        <Grid>
            <Viewport3D x:Name="viewport">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="camera"
                                     Position="0,2.4,5"
                                     LookDirection="0,-0.4,-1"
                                     UpDirection="0,1,0"
                                     FieldOfView="60"/>
            </Viewport3D.Camera>

            <!-- Lighting -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <DirectionalLight Color="White" Direction="-1,-1,-1"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <AmbientLight Color="#404040"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- Robot body (yellow) -->
            <ModelVisual3D x:Name="bodyModel">
                <ModelVisual3D.Content>
                    <GeometryModel3D x:Name="bodyGeometry">
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D x:Name="bodyMesh"/>
                        </GeometryModel3D.Geometry>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial>
                                <DiffuseMaterial.Brush>
                                    <SolidColorBrush Color="#FFE619"/>
                                </DiffuseMaterial.Brush>
                            </DiffuseMaterial>
                        </GeometryModel3D.Material>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- Robot head (red top part) -->
            <ModelVisual3D x:Name="headModel">
                <ModelVisual3D.Content>
                    <GeometryModel3D x:Name="headGeometry">
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D x:Name="headMesh"/>
                        </GeometryModel3D.Geometry>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial>
                                <DiffuseMaterial.Brush>
                                    <SolidColorBrush Color="Red"/>
                                </DiffuseMaterial.Brush>
                            </DiffuseMaterial>
                        </GeometryModel3D.Material>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- Ground plane -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <GeometryModel3D>
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D
                                Positions="-5,-0.01,-5 5,-0.01,-5 5,-0.01,5 -5,-0.01,5"
                                TriangleIndices="0,2,1 0,3,2"/>
                        </GeometryModel3D.Geometry>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial>
                                <DiffuseMaterial.Brush>
                                    <SolidColorBrush Color="#404040" Opacity="0.5"/>
                                </DiffuseMaterial.Brush>
                            </DiffuseMaterial>
                        </GeometryModel3D.Material>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- Coordinate axes -->
            <!-- X-axis (Red) -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <GeometryModel3D>
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D
                                Positions="0,0,0 2,0,0 2,0.02,0 0,0.02,0 0,0,0.02 2,0,0.02 2,0.02,0.02 0,0.02,0.02"
                                TriangleIndices="0,1,2 0,2,3 4,6,5 4,7,6 0,4,5 0,5,1 1,5,6 1,6,2 2,6,7 2,7,3 3,7,4 3,4,0"/>
                        </GeometryModel3D.Geometry>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial>
                                <DiffuseMaterial.Brush>
                                    <SolidColorBrush Color="Red"/>
                                </DiffuseMaterial.Brush>
                            </DiffuseMaterial>
                        </GeometryModel3D.Material>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- Y-axis (Green) -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <GeometryModel3D>
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D
                                Positions="0,0,0 0,2,0 0.02,2,0 0.02,0,0 0,0,0.02 0,2,0.02 0.02,2,0.02 0.02,0,0.02"
                                TriangleIndices="0,1,2 0,2,3 4,6,5 4,7,6 0,4,5 0,5,1 1,5,6 1,6,2 2,6,7 2,7,3 3,7,4 3,4,0"/>
                        </GeometryModel3D.Geometry>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial>
                                <DiffuseMaterial.Brush>
                                    <SolidColorBrush Color="Green"/>
                                </DiffuseMaterial.Brush>
                            </DiffuseMaterial>
                        </GeometryModel3D.Material>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- Z-axis (Blue) -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <GeometryModel3D>
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D
                                Positions="0,0,0 0,0,2 0,0.02,2 0,0.02,0 0.02,0,0 0.02,0,2 0.02,0.02,2 0.02,0.02,0"
                                TriangleIndices="0,1,2 0,2,3 4,6,5 4,7,6 0,4,5 0,5,1 1,5,6 1,6,2 2,6,7 2,7,3 3,7,4 3,4,0"/>
                        </GeometryModel3D.Geometry>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial>
                                <DiffuseMaterial.Brush>
                                    <SolidColorBrush Color="Blue"/>
                                </DiffuseMaterial.Brush>
                            </DiffuseMaterial>
                        </GeometryModel3D.Material>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

            <!-- Data Table Overlay -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="10"
                    Background="#DD222222"
                    BorderBrush="#FF888888"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" Color="Black" Opacity="0.5" ShadowDepth="2"/>
                </Border.Effect>
                <DataGrid x:Name="dataGrid"
                         AutoGenerateColumns="False"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FF00FF00"
                         FontSize="10"
                         HeadersVisibility="Column"
                         IsReadOnly="True"
                         RowBackground="Transparent"
                         AlternatingRowBackground="#11FFFFFF"
                         FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Hidden"
                         VerticalScrollBarVisibility="Hidden"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         CanUserReorderColumns="False"
                         CanUserResizeColumns="False"
                         CanUserResizeRows="False"
                         GridLinesVisibility="None"
                         Width="250"
                         Height="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Accel X" Binding="{Binding AccelX}" Width="45"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding AccelY}" Width="25"/>
                        <DataGridTextColumn Header="Z" Binding="{Binding AccelZ}" Width="25"/>
                        <DataGridTextColumn Header="Gyro X" Binding="{Binding GyroX}" Width="45"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding GyroY}" Width="25"/>
                        <DataGridTextColumn Header="Z" Binding="{Binding GyroZ}" Width="25"/>
                    </DataGrid.Columns>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#AA444444"/>
                            <Setter Property="Foreground" Value="#FF00FF00"/>
                            <Setter Property="BorderBrush" Value="#FF555555"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="FontSize" Value="9"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#FF00FF00"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="2"/>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</UserControl>
