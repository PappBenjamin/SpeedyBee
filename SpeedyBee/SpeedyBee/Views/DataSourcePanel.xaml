<UserControl x:Class="SpeedyBee.Views.DataSourcePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <GroupBox Header="Data Source" Margin="0,0,0,20">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <RadioButton x:Name="rbRedis" Content="Redis (Real-time)" GroupName="DataSource" Margin="0,0,20,0" Checked="DataSource_Checked"/>
            <RadioButton x:Name="rbCsv" Content="CSV File" GroupName="DataSource" Margin="0,0,20,0" Checked="DataSource_Checked"/>
            <Button x:Name="btnSelectCsv" Content="Browse..." IsEnabled="{Binding ElementName=rbCsv, Path=IsChecked}" Click="btnSelectCsv_Click" Padding="10,5"/>
            <Label x:Name="lblSelectedFile" Content="" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </GroupBox>
</UserControl>
